# Copy to .env and fill in. Never commit .env.

# Required
# Any phrase; the app asks for it each time it opens.
APP_PASSPHRASE=
GEMINI_API_KEY=
GROQ_API_KEY=

# live (default): call the APIs and cache every response
# replay: cached responses only, for demos (same output every time, works offline)
LLM_MODE=live

# Optional: your Google Sheet log. Paste the whole service-account JSON on one line,
# or point to the file. Share the Sheet with the service account's email as an editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional: Firestore instead of local JSON files
STORAGE_BACKEND=json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
